---
/**
 * Base document: head, fonts, global styles, header, footer.
 * Canonical/Open Graph/structured data are added in build step 5.
 */
import '../styles/global.css';
import Header, { type Section } from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Active main-nav section. */
  current?: Section;
  /** Footer hairline divider (use when the footer follows an ink section). */
  footerDivider?: boolean;
}

const { title, description, current, footerDivider = false } = Astro.props;
const siteName = 'HybridRaceCo';
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <slot name="before-header" />
    <Header current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer divider={footerDivider} />
  </body>
</html>
