---
import Base from '../layouts/Base.astro';
import NextRaceStrip from '../components/NextRaceStrip.astro';
import LeadStory from '../components/LeadStory.astro';
import LatestList from '../components/LatestList.astro';
import StartHere from '../components/StartHere.astro';
import StationGrid from '../components/StationGrid.astro';
import PillarColumns from '../components/PillarColumns.astro';
import NewsletterBand from '../components/NewsletterBand.astro';
import { PILLARS, getPublishedArticles, type Article, type Pillar } from '../lib/articles';

const LATEST_COUNT = 5;
const PER_PILLAR = 3;

// Editorial rules: newest article leads, the next five are Latest, and each pillar
// column shows its newest three that are not already on the page above.
const articles = await getPublishedArticles();
const [lead, ...others] = articles;
const latest = others.slice(0, LATEST_COUNT);
const shown = new Set([lead, ...latest].filter(Boolean).map((a) => a.id));

const columns = Object.fromEntries(
  PILLARS.map(({ slug }) => [
    slug,
    articles.filter((a) => a.data.pillar === slug && !shown.has(a.id)).slice(0, PER_PILLAR),
  ]),
) as Record<Pillar, Article[]>;
---

<Base
  title="HybridRaceCo"
  description="Independent HYROX and hybrid racing coverage: training, races and news, gear."
>
  <NextRaceStrip slot="before-header" />

  <section class="container hero" aria-label="Lead story and latest">
    {lead && <LeadStory article={lead} />}
    <LatestList articles={latest} />
  </section>

  <StartHere />
  <StationGrid />
  <PillarColumns columns={columns} />
  <NewsletterBand />
</Base>

<style>
  .hero {
    padding-top: 40px;
    padding-bottom: 56px;
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
  }
</style>
