---
/**
 * Per-page SEO tags: title, description, canonical, Open Graph, Twitter card, RSS discovery
 * and optional JSON-LD structured data.
 */
import { SITE_LOCALE, SITE_NAME } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Open Graph type. Articles pass "article". */
  type?: 'website' | 'article';
  /** Absolute or root-relative image URL. Omitted when there is no real image yet. */
  image?: string;
  imageAlt?: string;
  /** Article timestamps for Open Graph. */
  publishedTime?: Date;
  section?: string;
  tags?: string[];
  /** Structured data objects, each rendered as its own JSON-LD script. */
  jsonLd?: Record<string, unknown>[];
  /** Keep the page out of search results (404). Drops the canonical link. */
  noindex?: boolean;
}

const {
  title,
  description,
  type = 'website',
  image,
  imageAlt,
  publishedTime,
  section,
  tags = [],
  jsonLd = [],
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = image ? new URL(image, Astro.site).href : undefined;
const rssUrl = new URL('/rss.xml', Astro.site).href;
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical.href} />}
<link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={rssUrl} />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content={SITE_LOCALE} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
{imageUrl && <meta property="og:image" content={imageUrl} />}
{imageUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{section && <meta property="article:section" content={section} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}

{jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
