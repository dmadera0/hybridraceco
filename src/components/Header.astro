---
/**
 * Site header. Ported from the <header> block in design/home.html and design/article.html.
 * `current` marks the active section link (underline, aria-current).
 */
export type Section = 'training' | 'races-news' | 'gear' | 'stations' | 'start-here';

interface Props {
  current?: Section;
}

const { current } = Astro.props;

const links: { key: Section; href: string; label: string }[] = [
  { key: 'training', href: '/training/', label: 'Training' },
  { key: 'races-news', href: '/races-news/', label: 'Races & News' },
  { key: 'gear', href: '/gear/', label: 'Gear' },
  { key: 'stations', href: '/#stations', label: 'Station Guides' },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="wordmark" href="/">Hybrid<span class="wordmark__mark">Race</span>Co</a>
    <nav aria-label="Main" class="main-nav">
      {links.map(({ key, href, label }) => (
        <a href={href} class="main-nav__link" aria-current={current === key ? 'page' : undefined}>{label}</a>
      ))}
      <a href="/start-here/" class="main-nav__cta" aria-current={current === 'start-here' ? 'page' : undefined}>Start here</a>
      <button type="button" class="search-button" aria-label="Search">
        <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.8-3.8"></path></svg>
      </button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--rule-heavy);
  }

  .site-header__inner {
    padding-top: 14px;
    padding-bottom: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    align-items: center;
    justify-content: space-between;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 34px;
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    padding: 6px 0;
  }

  .wordmark__mark {
    background: var(--accent);
    padding: 0 6px;
    margin: 0 3px;
  }

  .main-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
    align-items: center;
    font-size: 15px;
    font-weight: 600;
  }

  .main-nav__link {
    padding: 12px 0;
  }

  /* Active section underline, as in design/article.html */
  .main-nav__link[aria-current='page'] {
    box-shadow: inset 0 -3px 0 var(--ink);
  }

  .main-nav__cta {
    padding: 10px 16px;
    border: 2px solid var(--ink);
  }

  .main-nav__cta[aria-current='page'] {
    background: var(--ink);
    color: var(--ground);
  }

  .search-button {
    width: var(--tap-min);
    height: var(--tap-min);
    border: 0;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }
</style>
